# Firebase — credenciais do app web.
#
# Copie este arquivo para `.env` e preencha com os valores do seu projeto:
#   Firebase Console > Configurações do projeto > Seus apps > Web
#
# `.env` está no .gitignore e NUNCA deve ser commitado.
# Este arquivo (.env.example) só documenta os nomes — mantenha-o sem valores.
#
# Observação: chaves VITE_* são embutidas no bundle e ficam visíveis no
# navegador. Isso é esperado para o Firebase Web — quem realmente protege
# os dados são as Security Rules do Firestore e as configurações de Auth,
# não o sigilo destas variáveis.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
